{
  "name": "job_harmony",
  "version": "1.0.0",
  "description": "An application resembling Tinder or Bumble that aims to connect people with potential employers based purely on qualifications.",
  "main": "app.ts",
  "scripts": {
    "server:debug": "tsx watch --inspect app.ts",
    "server": "tsx watch app.ts",
    "start": "tsx app.ts",
    "start:prod": "node dist/app.js",
    "build": "tsc",
    "frontend-install": "npm install --prefix frontend",
    "frontend": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmhernandez2525/Job-Harmony.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dmhernandez2525/Job-Harmony/issues"
  },
  "homepage": "https://github.com/dmhernandez2525/Job-Harmony#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "express": "^4.21.2",
    "@faker-js/faker": "^9.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.2.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.12.2",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
